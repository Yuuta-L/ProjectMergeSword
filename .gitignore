# Locus 工具生成的 C# 分析配置（可安全删除，工具会自动重建）
Directory.Build.props

# 本地工具目录
/Locus
node_modules

# Locus 编辑器工具包（随工具自身升级，不入版本库）
/Packages/com.farlocus.locus/
